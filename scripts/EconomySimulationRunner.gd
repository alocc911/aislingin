extends SceneTree

# Deterministic, headless economy experiment; no changes to gameplay tuning.
# Run: godot --headless --path . --script res://scripts/EconomySimulationRunner.gd -- --output-dir /absolute/path
const ProvinceSystemScript = preload("res://scripts/ProvinceSystem.gd")
const LevelConfig = preload("res://scripts/LevelConfig.gd")
const TURN_COUNT: int = 100

class SimMain extends Node:
	var _province_persistence: Array[Dictionary] = []
	var province_system = null
	var provinces_root: Node2D = Node2D.new()
	var gold_balance: int = 0
	var _construction_build_mode_enabled: bool = false
	var _current_phase: String = "grand_map"
	var _locked_province_id_after_win: int = -1
	var map_seed: int = 17

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var output_dir: String = "user://"
	var argv: PackedStringArray = OS.get_cmdline_user_args()
	for i in range(argv.size() - 1):
		if argv[i] == "--output-dir":
			output_dir = argv[i + 1]
	if output_dir == "":
		output_dir = "user://"
	var absolute_dir: String = ProjectSettings.globalize_path(output_dir) if output_dir.begins_with("user://") else output_dir
	var mkdir_error: Error = DirAccess.make_dir_recursive_absolute(absolute_dir)
	if mkdir_error != OK:
		printerr("Cannot create simulation output directory: ", absolute_dir)
		quit(2)
		return
	var csv_lines: Array[String] = ["scenario,turn,owner,treasury,natives,outlanders,native_happiness,outlander_happiness,food_production,food_demand,food_surplus,income,recruitment,construction,troops,buildings,active_project,revolted"]
	var scenario_configs: Array[Dictionary] = [
		{"name": "Neglected", "strategy": "neglect", "starting_gold": 40},
		{"name": "Managed", "strategy": "managed", "starting_gold": 40},
		{"name": "Growth-first", "strategy": "growth", "starting_gold": 75},
		{"name": "War-damaged", "strategy": "war", "starting_gold": 40}
	]
	var summaries: Array[Dictionary] = []
	for config in scenario_configs:
		var summary: Dictionary = _simulate(config, csv_lines)
		summaries.append(summary)
		print("SIM_SCENARIO ", JSON.stringify(summary))
	var report: Dictionary = {
		"model": "actual ProvinceSystem.gd, isolated one-province strategic economy",
		"turns": TURN_COUNT,
		"baseline_code_unchanged": true,
		"scenarios": summaries,
		"limitations": ["No neighboring provinces, bosses, map conquests, or troop food demand", "Player management uses deterministic rules rather than perfect optimization", "War damage is scheduled at 8-turn intervals rather than generated by full combat"]
	}
	var json_path: String = absolute_dir.path_join("economy_100_turn_summary.json")
	var csv_path: String = absolute_dir.path_join("economy_100_turn_timeseries.csv")
	var json_file: FileAccess = FileAccess.open(json_path, FileAccess.WRITE)
	var csv_file: FileAccess = FileAccess.open(csv_path, FileAccess.WRITE)
	if json_file == null or csv_file == null:
		printerr("Could not open simulation output")
		quit(3)
		return
	json_file.store_string(JSON.stringify(report, "\t"))
	json_file.close()
	for line in csv_lines:
		csv_file.store_line(line)
	csv_file.close()
	print("ECONOMY_SIMULATION_COMPLETE ", JSON.stringify({"summary": json_path, "csv": csv_path, "rows": csv_lines.size() - 1}))
	quit(0)

func _simulate(config: Dictionary, csv_lines: Array[String]) -> Dictionary:
	var strategy: String = String(config["strategy"])
	var province: Dictionary = {
		"id": 7001,
		"type": LevelConfig.PROVINCE_TYPE_FRIENDLY,
		"faction_id": 0,
		"remaining_troops": 5,
		"remaining_buildings": 0,
		"building_capacity": 12,
		"neighbors": []
	}
	var ps = ProvinceSystemScript.new()
	var main := SimMain.new()
	main.gold_balance = int(config["starting_gold"])
	main._province_persistence = [province]
	main.province_system = ps
	if strategy == "neglect":
		ps.setup(null)
	else:
		ps.setup(main)
	ps.normalize_province_economy_state(province)
	var revolts: int = 0
	var shortage_turns: int = 0
	var overcrowding_turns: int = 0
	var maximum_income: float = 0.0
	var maximum_recruitment: float = 0.0
	var maximum_construction: float = 0.0
	var minimum_happiness: float = 100.0
	var maximum_population: float = 0.0
	var last_gold: int = main.gold_balance
	var aggregate_income: int = 0
	var manual_projects: int = 0
	var combat_building_losses: int = 0
	for turn in range(1, TURN_COUNT + 1):
		var player_owned: bool = String(province.get("type", "")) == LevelConfig.PROVINCE_TYPE_FRIENDLY
		if player_owned:
			var credited: int = ps.get_province_total_income(province)
			main.gold_balance += credited
			aggregate_income += credited
		if strategy == "war" and turn > 1 and turn % 8 == 0 and player_owned:
			var occupied: int = ps.calculate_occupied_building_slots(province)
			if occupied > 0:
				ps.set_typed_building_count_ceiling(province, occupied - 1, true)
				combat_building_losses += 1
		if player_owned and strategy != "neglect":
			if _try_manual_plan(ps, province, strategy):
				manual_projects += 1
		var result: Dictionary = ps.tick_province_economy(province)
		if bool(result.get("revolted", false)):
			revolts += 1
		var p: Dictionary = province.get("population", {})
		var h: Dictionary = province.get("happiness", {})
		var food: Dictionary = province.get("food", {})
		var rates: Dictionary = province.get("rates", {})
		var acc: Dictionary = province.get("accommodation", {})
		var natives: float = float(p.get("natives", 0.0))
		var outlanders: float = float(p.get("outlanders", 0.0))
		var nh: float = float(h.get("natives", 0.0))
		var oh: float = float(h.get("outlanders", 0.0))
		var surplus: float = float(food.get("surplus", 0.0))
		if surplus < 0.0:
			shortage_turns += 1
		if natives > float(acc.get("native_ceiling", 0.0)) or outlanders > float(acc.get("outlander_ceiling", 0.0)):
			overcrowding_turns += 1
		minimum_happiness = minf(minimum_happiness, minf(nh, oh))
		maximum_population = maxf(maximum_population, natives + outlanders)
		maximum_income = maxf(maximum_income, float(rates.get("income", 0.0)))
		maximum_recruitment = maxf(maximum_recruitment, float(rates.get("recruitment", 0.0)))
		maximum_construction = maxf(maximum_construction, float(rates.get("construction", 0.0)))
		var project: Dictionary = province.get("active_construction", {})
		var cols: Array[String] = [
			String(config["name"]), str(turn),
			String(province.get("type", "")), str(main.gold_balance),
			"%.2f" % natives, "%.2f" % outlanders,
			"%.2f" % nh, "%.2f" % oh,
			"%.2f" % float(food.get("production", 0.0)),
			"%.2f" % float(food.get("demand", 0.0)),
			"%.2f" % surplus,
			"%.2f" % float(rates.get("income", 0.0)),
			"%.2f" % float(rates.get("recruitment", 0.0)),
			"%.2f" % float(rates.get("construction", 0.0)),
			str(int(province.get("remaining_troops", 0))),
			str(ps.calculate_occupied_building_slots(province)),
			String(project.get("project_type", "none")),
			"1" if bool(result.get("revolted", false)) else "0"
		]
		csv_lines.append(",".join(cols))
		last_gold = main.gold_balance
	var final_population: Dictionary = province.get("population", {})
	var final_happiness: Dictionary = province.get("happiness", {})
	var summary: Dictionary = {
		"scenario": String(config["name"]),
		"starting_gold": int(config["starting_gold"]),
		"ending_gold": last_gold,
		"cumulative_income": aggregate_income,
		"revolts": revolts,
		"food_shortage_turns": shortage_turns,
		"overcrowding_turns": overcrowding_turns,
		"manual_projects_started": manual_projects,
		"combat_building_losses": combat_building_losses,
		"final_owner": String(province.get("type", "")),
		"final_natives": snapped(float(final_population.get("natives", 0.0)), 0.01),
		"final_outlanders": snapped(float(final_population.get("outlanders", 0.0)), 0.01),
		"final_native_happiness": snapped(float(final_happiness.get("natives", 0.0)), 0.01),
		"final_outlander_happiness": snapped(float(final_happiness.get("outlanders", 0.0)), 0.01),
		"peak_total_population": snapped(maximum_population, 0.01),
		"lowest_happiness": snapped(minimum_happiness, 0.01),
		"peak_income_rate": snapped(maximum_income, 0.01),
		"peak_recruitment_rate": snapped(maximum_recruitment, 0.01),
		"peak_construction_rate": snapped(maximum_construction, 0.01),
		"final_troops": int(province.get("remaining_troops", 0)),
		"final_buildings": ps.calculate_occupied_building_slots(province)
	}
	ps.free()
	main.provinces_root.free()
	main.free()
	return summary

func _try_manual_plan(ps: Object, province: Dictionary, strategy: String) -> bool:
	if not (province.get("active_construction", {}) as Dictionary).is_empty():
		return false
	var food: Dictionary = province.get("food", {})
	var pop: Dictionary = province.get("population", {})
	var acc: Dictionary = province.get("accommodation", {})
	var effects: Dictionary = province.get("buildings", {})
	var farm_count: int = ps.get_typed_building_count(province, "farm")
	var native_gap: float = float(acc.get("native_ceiling", 0.0)) - float(pop.get("natives", 0.0))
	var outlander_gap: float = float(acc.get("outlander_ceiling", 0.0)) - float(pop.get("outlanders", 0.0))
	var plans: Array[Dictionary] = []
	if strategy == "war" and not ps._find_repair_candidate(province).is_empty():
		plans.append({"request_type": "repair", "building_type": "defense_nest", "tier": 1})
	if strategy == "growth" and ps.get_typed_building_count(province, "growth_increaser") < 2:
		plans.append({"request_type": "build", "building_type": "growth_increaser", "tier": 1})
	if float(food.get("surplus", 0.0)) < (3.0 if strategy == "growth" else 12.0):
		plans.append({"request_type": "build", "building_type": "farm", "tier": 1})
	if native_gap < (3.0 if strategy == "growth" else 15.0):
		plans.append({"request_type": "build", "building_type": "tenement", "tier": 1})
	if outlander_gap < (2.0 if strategy == "growth" else 8.0):
		plans.append({"request_type": "build", "building_type": "mansion", "tier": 1})
	if strategy == "growth":
		plans.append({"request_type": "build", "building_type": "club_factory", "tier": 1})
	else:
		plans.append({"request_type": "build", "building_type": "mansion", "tier": 1})
	if farm_count > 0 and float(food.get("surplus", 0.0)) < 6.0:
		plans.append({"request_type": "upgrade", "building_type": "farm", "tier": 1})
	for action in plans:
		if ps._start_construction_action(province, action, false):
			return true
	return false
